{
  "manifest_version": 3,
  "name": "GVH-以图搜图助手",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "通用多引擎以图搜图：悬停图片选引擎直开，框选截图自动上传 Yandex / Google Lens 识图。引擎明文自定义。",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "notifications",
    "downloads",
    "clipboardWrite",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "ysx-capture": {
      "suggested_key": {
        "default": "Alt+Y",
        "mac": "Alt+Y"
      },
      "description": "框选截图并自动识图（Yandex / Google Lens）"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n.js",
        "defaults.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "GVH-以图搜图助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
